# Install outside the public repository as /etc/nanaly.env, owned by root, mode 0600.
# Create the token separately without printing it: 32 random bytes encoded as hex.
# /etc/nanaly/token must be readable by nanaly; production uses nanaly:nanaly 0400.
NANALY_TOKEN_FILE=/etc/nanaly/token
# Optional: a second, restricted token for GitHub Actions (read public memories, append events only).
# NANALY_AUTOMATION_TOKEN_FILE=/etc/nanaly/automation-token
NANALY_DATA_DIR=/srv/nanaly-private
NANALY_ALLOWED_ORIGINS=https://your-blog.example
NANALY_RUNNER_IMAGE=nanaly-runner:1
HOST=127.0.0.1
PORT=4318
# Replace @NANALY_UID@ with `id -u nanaly`; it is host-specific.
DOCKER_HOST=unix:///run/user/@NANALY_UID@/docker.sock
XDG_RUNTIME_DIR=/run/user/@NANALY_UID@
PATH=/usr/local/bin:/usr/bin:/bin
