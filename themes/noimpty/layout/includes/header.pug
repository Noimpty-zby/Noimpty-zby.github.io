header.site-head
  .site-head__in
    a.logo(href=url_for('/') data-title="Noimpty" data-sc="#f0508a" data-avatar)
      span.logo__mark(aria-hidden="true")
      span.logo__text Noimpty
    nav.nav#nav(aria-label="主导航")
      each item in theme.menu
        - var current = nm_nav_current(item.path, page, is_home())
        - var hub = theme.hubs && theme.hubs[item.path]
        a(href=url_for(item.path) aria-current=current ? 'page' : undefined data-title=item.name data-sc=hub ? hub.color : undefined data-code=hub ? hub.code : undefined data-avatar=item.path === '/' ? '' : undefined)
          span= item.name
          i(aria-hidden="true")= item.en
      if theme.private_menu && theme.private_menu.length
        .nav-more
          button.nav-more__btn(type="button" aria-expanded="false" aria-haspopup="true")
            span 私人
            i(aria-hidden="true") OWNER
          .nav-more__panel(role="menu")
            each item in theme.private_menu
              a(href=url_for(item.path) role="menuitem" data-title=item.name)= item.name
    span#search-button.search-btn
      a(href="#" role="button" aria-label="搜索" title="搜索")
        svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true")
          circle(cx="11" cy="11" r="7")
          path(d="m20 20-3.5-3.5")
    button.nav-toggle(type="button" aria-label="打开菜单" aria-expanded="false")
      span(aria-hidden="true")
